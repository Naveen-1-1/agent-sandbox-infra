{
  "name": "activity",
  "displayName": "sbx activity",
  "description": "Tells the sbx platform about edits, saves and terminal commands, so an idle workspace can sleep and a busy one stays awake.",
  "publisher": "sbx",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.93.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.cjs",
    "check": "tsc",
    "test": "node --test test/reporter.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.93.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
